# Copy to .env and fill in. Everything here is optional except where noted.

# ---- ElevenLabs (optional) ----
# Without a key the app still works: the UI's "Listen" button is simply disabled.
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice used for spoken explanations. 21m00Tcm4TlvDq8ikWAM is "Rachel", a default
# voice available on the free tier.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_turbo_v2_5 is the cheapest/fastest model; it bills the fewest credits.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Hard cap on characters sent per request, so a runaway explanation cannot burn
# your credit balance. Text beyond this is truncated before it leaves the machine.
ELEVENLABS_MAX_CHARS=600
# Speech-to-text model used for spoken commands ("approve the top match", ...).
ELEVENLABS_STT_MODEL=scribe_v1

# ---- App ----
# Port the dev server binds to.
PORT=8000
